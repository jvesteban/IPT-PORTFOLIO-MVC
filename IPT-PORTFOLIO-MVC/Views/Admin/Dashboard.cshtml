@using System.Globalization
@model IPT_PORTFOLIO_MVC.ViewModels.Admin.AdminDashboardViewModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Admin dashboard";
    var inactivePercent = Model.TotalStudents == 0 ? 0 : 100 - Model.ActivePercent;
}
<div class="admin-dashboard">

    <header class="page-heading">
        <div>
            <p class="eyebrow">COMMUNITY OVERVIEW</p>
            <h1>Admin dashboard</h1>
            <p>A closer look at your student community.</p>
        </div>
        <a class="admin-button is-primary" asp-action="Students">
            <span>Manage students</span>
            <span class="arrow-icon" aria-hidden="true">&rarr;</span>
        </a>
    </header>

    <div class="metrics-row">
        <div class="metric-card admin-card">
            <span class="metric-label">Total registered</span>
            <div class="metric-value">@Model.TotalStudents</div>
            <span class="metric-subtext">Students in community</span>
        </div>
        <div class="metric-card admin-card">
            <span class="metric-label">Active accounts</span>
            <div class="metric-value text-active">@Model.ActiveStudents</div>
            <span class="metric-subtext">@(Model.ActivePercent.ToString("0.##", CultureInfo.InvariantCulture))% of total</span>
        </div>
        <div class="metric-card admin-card">
            <span class="metric-label">Inactive accounts</span>
            <div class="metric-value text-inactive">@Model.InactiveStudents</div>
            <span class="metric-subtext">Access paused</span>
        </div>
    </div>

    <div class="chart-grid">

        <section class="chart-panel admin-card" aria-labelledby="status-heading">
            <div class="panel-heading admin-panel-heading">
                <div>
                    <h2 id="status-heading">Account status</h2>
                    <span class="admin-panel-subtitle">Current distribution</span>
                </div>
                <span class="admin-pill">All students</span>
            </div>
            <figure class="status-chart">
                <div class="chart-surface" data-chart-tooltip>
                <div class="donut @(Model.TotalStudents == 0 ? "is-empty" : "")" tabindex="0" aria-describedby="status-tooltip" style="--active: @(Model.ActivePercent.ToString("0.##", CultureInfo.InvariantCulture))%;" role="img" aria-label="@Model.ActiveStudents active and @Model.InactiveStudents inactive students">
                    <div class="donut-total">
                        <strong>@Model.TotalStudents</strong>
                        <span>Total Students</span>
                    </div>
                </div>
                <div class="chart-tooltip status-tooltip" id="status-tooltip" role="tooltip">
                    <strong>Account status</strong>
                    <span class="tooltip-row"><i class="legend-dot active-dot" aria-hidden="true"></i>Active · Blue <b>@Model.ActiveStudents (@Model.ActivePercent.ToString("0.##")%)</b></span>
                    <span class="tooltip-row"><i class="legend-dot inactive-dot" aria-hidden="true"></i>Inactive · Amber <b>@Model.InactiveStudents (@inactivePercent.ToString("0.##")%)</b></span>
                    @if (Model.TotalStudents == 0) { <span>No students registered yet.</span> }
                </div>
                </div>
                <figcaption>Active vs. inactive account ratio</figcaption>
            </figure>
            <div class="chart-legend">
                <a asp-action="Students" asp-route-status="Active" class="legend-card" title="Filter by Active accounts">
                    <span class="legend-dot active-dot" aria-hidden="true"></span>
                    <span class="legend-name">Active</span>
                    <strong class="legend-count">@Model.ActiveStudents</strong>
                </a>
                <a asp-action="Students" asp-route-status="Inactive" class="legend-card" title="Filter by Inactive accounts">
                    <span class="legend-dot inactive-dot" aria-hidden="true"></span>
                    <span class="legend-name">Inactive</span>
                    <strong class="legend-count">@Model.InactiveStudents</strong>
                </a>
            </div>
        </section>

        <section class="chart-panel admin-card" aria-labelledby="registrations-heading">
            <div class="panel-heading admin-panel-heading">
                <div>
                    <h2 id="registrations-heading">Registrations</h2>
                    <span class="admin-panel-subtitle">6-month trend</span>
                </div>
            </div>
            <figure class="registration-chart">
                <ol class="monthly-bars" aria-label="Registrations by month">
                    @foreach (var month in Model.Registrations)
                    {
                        <li class="month-column" data-chart-tooltip tabindex="0" aria-label="@month.FullLabel: @month.Count registrations">
                            <span class="sr-only">@month.FullLabel: @month.Count registrations</span>
                            <div class="chart-tooltip registration-tooltip" role="tooltip">
                                <strong>@month.FullLabel</strong>
                                <span>@month.Count @(month.Count == 1 ? "student registered" : "students registered")</span>
                            </div>
                            <div class="bar-track" aria-hidden="true">
                                <div class="bar-fill @(month.Count == 0 ? "is-zero" : "")" style="height: @(month.HeightPercent.ToString("0.##", CultureInfo.InvariantCulture))%;">
                                    <span class="bar-count">@month.Count</span>
                                </div>
                            </div>
                            <span class="bar-label" aria-hidden="true">@month.Label</span>
                        </li>
                    }
                </ol>
                <figcaption>@(Model.Registrations.All(month => month.Count == 0) ? "No registrations in this period." : "Students registered each month.")</figcaption>
            </figure>
        </section>
    </div>

    <section class="activity-panel admin-card" aria-labelledby="activity-heading">
        <div class="panel-heading admin-panel-heading">
            <div>
                <h2 id="activity-heading">Latest student sign-ins</h2>
                <span class="admin-panel-subtitle">Most recent student activity</span>
            </div>
            <span class="admin-pill">@Model.NeverSignedIn never signed in</span>
        </div>
        @if (Model.RecentSignIns.Count == 0)
        {
            <div class="admin-empty-state">
                <h3>No student sign-ins yet</h3>
                <p>Recent student sign-ins will appear here when students use their accounts.</p>
            </div>
        }
        else
        {
            <ul class="activity-list">
                @foreach (var student in Model.RecentSignIns)
                {
                    <li class="activity-item">
                        <a asp-action="Student" asp-route-id="@student.StudentId" class="activity-link">
                            <div class="student-avatar-mini" aria-hidden="true">
                                <partial name="_ProfileAvatar" model='new IPT_PORTFOLIO_MVC.ViewModels.Shared.ProfileAvatarViewModel(student.StudentId, string.IsNullOrWhiteSpace(student.FullName) ? "ST" : student.FullName.Trim().Substring(0, 1).ToUpperInvariant())' />
                            </div>
                            <div class="activity-meta">
                                <strong>@student.FullName</strong>
                                <span>@@@student.Username</span>
                            </div>
                            <div class="activity-time-wrap">
                                <time class="activity-time">@student.LastLoginLabel</time>
                                <span class="arrow-indicator" aria-hidden="true">&rarr;</span>
                            </div>
                        </a>
                    </li>
                }
            </ul>
        }
    </section>

    <p class="preview-caption">Student activity as of this page load.</p>
</div>
@section Styles { <link rel="stylesheet" href="~/css/admin/dashboard.css" asp-append-version="true" /> }
@section Scripts { <script src="~/js/admin/dashboard.js" asp-append-version="true"></script> }
