<dialog id="signout-dialog" aria-labelledby="signout-title" aria-describedby="signout-detail">
    <h2 id="signout-title">Sign out of your account?</h2>
    <p id="signout-detail">You’ll return to the login page.</p>
    <div class="signout-actions">
        <button type="button" data-stay-signed-in autofocus>Stay signed in</button>
        <button type="button" data-confirm-signout>Sign out</button>
    </div>
</dialog>
<script src="~/js/account/signout.js" asp-append-version="true"></script>
